# Copy to .env and fill in, or export these in your shell profile.
# Never commit the real .env file.

# 1. Anthropic API key — console.anthropic.com. This moves Agent Smith
#    from your Claude subscription to pay-per-token billing. A QUICK run
#    dispatches 5 sub-agents; budget accordingly (ask me for a token/cost
#    estimate once this is running if you want real numbers instead of
#    the earlier back-of-envelope one).
ANTHROPIC_API_KEY=sk-ant-...

# 2. FMP API key — free tier signup, no credit card:
#    https://site.financialmodelingprep.com/pricing-plans
#    (Agent Smith's existing evidence-principle notes some endpoints are
#    ACCESS DENIED on the free tier — secFilings works, statements and
#    earningsTranscript don't. If you already have a paid FMP account
#    from setting up the original connector, reuse that key here instead.)
FMP_API_KEY=...

# 3. ntfy.sh topic for push notifications — pick something long and
#    random, NOT "agent-smith" (topics are public if guessed). Generate
#    one yourself, e.g.:
#      python3 -c "import secrets; print('smith-' + secrets.token_hex(12))"
NTFY_TOPIC=smith-REPLACE-WITH-YOUR-OWN-RANDOM-STRING
