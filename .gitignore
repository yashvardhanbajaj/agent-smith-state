
# intermediate .bakN generations from multi-step edits -- git history is the rollback path
*.bak[0-9]
*.bak[0-9][0-9]
*.pyc
.running
__pycache__/
runs/*/shared/
scripts/__pycache__/

# standalone/ (Phase 1 - Claude Agent SDK port) - runtime/secrets, never track
standalone/.env
standalone/.venv/
standalone/node_modules/
standalone/__pycache__/
standalone/**/__pycache__/
**/.DS_Store

# archived intermediate backups -- kept on disk, out of the repo (ARCHIVE, NEVER DELETE)
archive/backups-pre-*/
.smith.writelock

# smith_fetch (2026-09-14): repo-local venv and bulky raw fetch outputs (inputs, re-fetchable)
.venv/
runs/*/bars.json
runs/*/chain_*.json
runs/*/dashboard_fetched.html

# run lock (script-owned, never versioned)
.smith.lock
.smith.writelock
logs/
