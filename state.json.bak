  "analyst_targets": {},
  "atr20": {
   "as_of": "2026-08-12 (partial refresh: STM, TXN, AMD, COHR, FLTW, BX added; others carried forward)",
   "window": "22 daily bars, 30 Jun - 30 Jul 2026 (includes full 07-28 crash + 07-29/30 relief rally)",
   "source": "yfinance daily OHLC, true-range method",
   "values_pct": {
    "ASML": 5.11,
