  "preferences": {
    "stop_loss_style": {
      "confirmed_by_user": "2026-07-27",
      "description": "User deliberately runs tight stop-losses across a large share of the US book simultaneously, and has confirmed this is the ongoing method, not a one-off. Trigger on 2026-07-24: 11 of 24 positions stopped in one session. Stated reason: was fully cash-deployed with zero dry powder, and holding an uncertain AI-capex book over a weekend was intolerable.",
      "implications_for_desk": [
        "Cash spikes far above the [3,15]% policy band are a RECURRING structural feature of this book, not a fresh defect to re-flag each run.",
        "Every redeployment proposal must be sized for stop-out probability, preferring lower-vol mega-caps over high-beta pure-plays when filling cluster gaps.",
        "Deployments should be staged in tranches around known binary events (FOMC, earnings), never in one shot.",
        "Recommend stop distances near 2x the name's recent daily range; stops at the prior day's low on 7-9% daily-range names are near-certain whipsaws.",
        "STANDING TENSION: the draft policy's cluster targets (Optics 20%, Power 15%, Memory 20%) force exposure to the highest-volatility parts of the AI-capex chain -- exactly what keeps stopping out. Fully curing a cash breach within the current bands REQUIRES buying the volatile clusters. Flag for user decision."
      ]
    },
    "diversification_dca_2026_08_03": {
      "note": "User confirmed the META/AMZN/BABA/QBTS/TSM weekend buys were deliberate DCA into diversification (reduce single-factor AI-capex concentration), not signal-reactive.",
      "date": "2026-08-03"
    },
    "iren_watchlist_2026_08_03": {
      "note": "After a 2nd full stop-out, user wants IREN kept on the watchlist as an active re-entry candidate, not dropped from consideration.",
      "date": "2026-08-03"
    },
    "proposal_actions_no_confirm": {
      "confirmed_by_user": "2026-08-04",
      "description": "Do NOT ask for confirmation before dismissing, retiring, or otherwise editing proposals when the user has named them. Act directly, then report what was done.",
      "scope": "proposals.json lifecycle actions (dismiss/retire/supersede) named by the user. Does NOT extend to trades, money movement, or confirming policy.json -- those still require explicit instruction."
    },
    "dashboard_the_read_style": "The read (narrative.json session_read) should stay forward-looking and judgment-level: no cash-position mentions, no yesterday-trade-reconciliation recap (those live in Changes since last run / Book & Risk instead). Include upcoming catalysts/earnings/FOMC dates and what would change the current read. 7d/21d portfolio performance is computed and shown automatically from ledger.csv, not narrated in prose. Confirmed 2026-09-09.",
    "standing_decisions": [
